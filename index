  <style>
    /* ==========================================================================
       1. VARIABLES & RESET
       ========================================================================== */
    :root {
      --green-950: #073b2d;
      --green-900: #084936;
      --green-800: #0c5a43;
      --green-700: #167052;
      --green-100: #e7f3ed;
      --gold: #d9b765;
      --gold-light: #f5e8bd;
      --ink: #18342b;
      --muted: #64776f;
      --paper: #fbfcf8;
      --white: #ffffff;
      --line: #e2ebe5;
      --shadow: 0 18px 45px rgba(7, 59, 45, .10);
      --shadow-hover: 0 22px 50px rgba(7, 59, 45, .18);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: var(--ink);
      background: var(--paper);
      line-height: 1.6;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; height: auto; display: block; }
    .container { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }

    /* ==========================================================================
       2. TOPBAR & HEADER NAV
       ========================================================================== */
    .topbar {
      background: var(--green-950);
      color: #eaf4ee;
      font-size: .82rem;
      padding: 8px 0;
    }
    .topbar-inner { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .topbar strong { color: var(--gold-light); font-weight: 600; }
    .topbar-link { color: var(--gold-light); text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
    .topbar-link:hover { color: #fff; }

    header {
      position: sticky; top: 0; z-index: 100;
      background: rgba(255,255,255,.96);
      border-bottom: 1px solid rgba(226,235,229,.9);
      backdrop-filter: blur(12px);
    }
    .nav { min-height: 78px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .brand-mark {
      width: 52px; height: 52px; border-radius: 50%; flex: 0 0 52px;
      display: block; object-fit: contain; background: #fff;
      border: 1px solid #e3ebe5; box-shadow: 0 5px 14px rgba(12,90,67,.12);
    }
    .brand-name { font-weight: 800; letter-spacing: -.03em; line-height: 1.15; font-size: 1.02rem; }
    .brand-sub { display: block; margin-top: 5px; color: var(--muted); font-size: .76rem; font-weight: 500; letter-spacing: 0; }
    .nav-links { display: flex; align-items: center; gap: 22px; font-size: .9rem; font-weight: 650; color: #3d5b4e; }
    .nav-links a:not(.btn) { transition: color .2s ease; }
    .nav-links a:not(.btn):hover { color: var(--green-700); }
    .nav-links a.active { color: var(--green-800); font-weight: 800; position: relative; }
    .nav-links a.active::after {
      content: ""; position: absolute; bottom: -6px; left: 0; right: 0; height: 2px;
      background: var(--gold); border-radius: 2px;
    }

    /* Buttons Style */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      border-radius: 12px; padding: 10px 18px; font-weight: 750; font-size: .88rem;
      transition: transform .2s ease, box-shadow .2s ease, background .2s ease, color .2s ease;
      cursor: pointer; border: none;
    }
    .btn-primary { color: white; background: var(--green-800); box-shadow: 0 8px 20px rgba(12,90,67,.16); }
    .btn-primary:hover { background: var(--green-950); transform: translateY(-2px); box-shadow: 0 10px 24px rgba(7,59,45,.22); }
    .btn-gold { color: var(--green-950); background: var(--gold-light); box-shadow: 0 8px 20px rgba(217,183,101,.25); }
    .btn-gold:hover { background: #fff1c8; transform: translateY(-2px); color: var(--green-950); }
    .btn-outline { color: var(--green-900); border: 1px solid #b9d0c4; background: rgba(255,255,255,.9); }
    .btn-outline:hover { background: white; border-color: var(--green-700); transform: translateY(-2px); }

    /* ==========================================================================
       3. PAGE HEADER BANNER
       ========================================================================== */
    .page-banner {
      overflow: hidden; position: relative; color: white;
      background:
        radial-gradient(circle at 82% 22%, rgba(217,183,101,.18), transparent 24%),
        radial-gradient(circle at 8% 100%, rgba(63,145,105,.28), transparent 30%),
        linear-gradient(120deg, #073b2d 0%, #0b5a42 57%, #176b50 100%);
      padding: 56px 0 68px;
    }
    .page-banner::before {
      content: ""; position: absolute; inset: 0; opacity: .13; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg width='76' height='76' viewBox='0 0 76 76' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23f5e8bd' stroke-width='1'%3E%3Cpath d='M38 4 48 14 62 14 62 28 72 38 62 48 62 62 48 62 38 72 28 62 14 62 14 48 4 38 14 28 14 14 28 14Z'/%3E%3Cpath d='M38 18 45 25 51 25 51 31 58 38 51 45 51 51 45 51 38 58 31 51 25 51 25 45 18 38 25 31 25 31 25Z'/%3E%3C/g%3E%3C/svg%3E");
    }
    .banner-inner {
      position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; text-align: center;
    }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px;
      border: 1px solid rgba(245,232,189,.38); border-radius: 999px;
      background: rgba(255,255,255,.07); color: var(--gold-light);
      text-transform: uppercase; letter-spacing: .12em; font-size: .72rem; font-weight: 800;
      margin-bottom: 16px;
    }
    .eyebrow-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); }
    .page-banner h1 { margin: 0 0 14px; font-size: clamp(2.1rem, 4.5vw, 3.2rem); letter-spacing: -.04em; line-height: 1.15; }
    .page-banner h1 span { color: var(--gold-light); }
    .page-banner p { margin: 0 0 24px; max-width: 640px; color: #d7e9df; font-size: 1.05rem; }
    .banner-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }

    /* ==========================================================================
       4. FILTER CONTROLS
       ========================================================================== */
    .filter-wrapper {
      position: relative; margin-top: -28px; z-index: 5; margin-bottom: 40px;
    }
    .filter-bar {
      display: flex; justify-content: center; align-items: center; gap: 8px; flex-wrap: wrap;
      background: white; padding: 10px 14px; border-radius: 20px;
      box-shadow: var(--shadow); border: 1px solid var(--line);
      width: fit-content; margin: 0 auto;
    }
    .filter-btn {
      border: none; background: transparent; padding: 9px 18px; border-radius: 12px;
      color: var(--muted); font-weight: 700; font-size: .88rem; cursor: pointer;
      transition: all .2s ease; display: inline-flex; align-items: center; gap: 6px;
    }
    .filter-btn:hover { color: var(--green-800); background: var(--green-100); }
    .filter-btn.active { background: var(--green-800); color: white; box-shadow: 0 4px 12px rgba(12,90,67,.2); }

    /* ==========================================================================
       5. GALLERY GRID & CARDS
       ========================================================================== */
    .gallery-section { padding-bottom: 80px; flex-grow: 1; }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 26px;
      transition: opacity .3s ease;
    }
    .gallery-card {
      background: white; border: 1px solid var(--line); border-radius: 20px;
      overflow: hidden; box-shadow: var(--shadow);
      display: flex; flex-direction: column;
      transition: transform .3s ease, box-shadow .3s ease, opacity .3s ease;
      opacity: 1;
    }
    .gallery-card.hide { display: none; }
    .gallery-card:hover {
      transform: translateY(-6px); box-shadow: var(--shadow-hover);
    }
    .card-thumb {
      position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: #e8f3ed; cursor: pointer;
    }
    .card-thumb img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform .5s cubic-bezier(.16, 1, .3, 1);
    }
    .gallery-card:hover .card-thumb img {
      transform: scale(1.06);
    }
    .card-badge {
      position: absolute; top: 14px; left: 14px; z-index: 2;
      background: rgba(7, 59, 45, .85); color: var(--gold-light);
      padding: 5px 12px; border-radius: 999px; font-size: .72rem; font-weight: 800;
      letter-spacing: .03em; backdrop-filter: blur(6px); border: 1px solid rgba(245,232,189,.3);
    }
    .card-overlay {
      position: absolute; inset: 0; background: rgba(7, 59, 45, .4);
      display: flex; align-items: center; justify-content: center; color: white;
      opacity: 0; transition: opacity .3s ease;
    }
    .gallery-card:hover .card-overlay { opacity: 1; }
    .overlay-icon {
      width: 44px; height: 44px; border-radius: 50%; background: var(--gold-light); color: var(--green-950);
      display: grid; place-items: center; box-shadow: 0 6px 16px rgba(0,0,0,.2);
      transform: scale(.8); transition: transform .3s ease;
    }
    .gallery-card:hover .overlay-icon { transform: scale(1); }

    .card-body {
      padding: 22px; display: flex; flex-direction: column; flex-grow: 1;
    }
    .card-meta {
      display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: .8rem; margin-bottom: 8px;
    }
    .card-meta svg { width: 15px; height: 15px; color: var(--green-700); flex-shrink: 0; }
    .card-title {
      margin: 0 0 8px; font-size: 1.08rem; color: var(--green-950); letter-spacing: -.02em; font-weight: 800; line-height: 1.35;
    }
    .card-desc {
      margin: 0; color: var(--muted); font-size: .88rem; line-height: 1.5;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }
    .card-footer {
      margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line);
      display: flex; align-items: center; justify-content: space-between;
    }
    .btn-preview {
      color: var(--green-800); font-weight: 750; font-size: .84rem; display: inline-flex; align-items: center; gap: 6px;
      cursor: pointer; background: none; border: none; padding: 0;
    }
    .btn-preview:hover { color: var(--green-950); }

    /* Empty state */
    .no-results {
      grid-column: 1 / -1; text-align: center; padding: 60px 20px; background: white;
      border-radius: 20px; border: 1px solid var(--line); color: var(--muted);
      display: none;
    }
    .no-results svg { width: 48px; height: 48px; color: var(--muted); margin-bottom: 12px; }

    /* ==========================================================================
       6. LIGHTBOX MODAL PREVIEW
       ========================================================================== */
    .lightbox-modal {
      position: fixed; inset: 0; z-index: 1000;
      background: rgba(5, 30, 23, .92); backdrop-filter: blur(10px);
      display: flex; align-items: center; justify-content: center; padding: 20px;
      opacity: 0; visibility: hidden; transition: opacity .3s ease, visibility .3s ease;
    }
    .lightbox-modal.active { opacity: 1; visibility: visible; }
    
    .lightbox-content {
      background: white; border-radius: 24px; max-width: 900px; width: 100%;
      max-height: 90vh; overflow: hidden; display: grid; grid-template-columns: 1.2fr .8fr;
      box-shadow: 0 25px 60px rgba(0,0,0,.4); position: relative;
      transform: scale(.95); transition: transform .3s ease;
    }
    .lightbox-modal.active .lightbox-content { transform: scale(1); }

    .lightbox-image-wrap {
      background: #04241b; display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden; min-height: 320px;
    }
    .lightbox-image-wrap img {
      width: 100%; height: 100%; object-fit: contain; max-height: 80vh;
    }
    
    .lightbox-details {
      padding: 32px; display: flex; flex-direction: column; overflow-y: auto;
    }
    .lightbox-close {
      position: absolute; top: 16px; right: 16px; width: 36px; height: 36px;
      border-radius: 50%; background: rgba(0,0,0,.1); border: none; cursor: pointer;
      display: grid; place-items: center; color: var(--ink); transition: background .2s;
      z-index: 10;
    }
    .lightbox-close:hover { background: var(--green-100); color: var(--green-950); }
    .lightbox-tag {
      align-self: flex-start; background: var(--green-100); color: var(--green-800);
      font-size: .75rem; font-weight: 800; padding: 4px 12px; border-radius: 999px; margin-bottom: 12px;
    }
    .lightbox-title { margin: 0 0 12px; font-size: 1.4rem; color: var(--green-950); line-height: 1.3; }
    .lightbox-date { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: .85rem; margin-bottom: 18px; }
    .lightbox-desc { color: #3d5b4e; font-size: .95rem; line-height: 1.6; margin: 0 0 24px; flex-grow: 1; }

    .lightbox-nav {
      display: flex; gap: 10px; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line);
    }
    .nav-btn-modal {
      flex: 1; padding: 10px; border-radius: 10px; border: 1px solid var(--line); background: var(--paper);
      color: var(--ink); font-weight: 700; font-size: .82rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px;
      transition: background .2s;
    }
    .nav-btn-modal:hover { background: var(--green-100); color: var(--green-900); }

    /* ==========================================================================
       7. FOOTER
       ========================================================================== */
    footer { background: #052f24; color: #d8e8df; padding: 42px 0 24px; margin-top: auto; }
    .footer-main { display: flex; justify-content: space-between; gap: 32px; align-items: flex-start; padding-bottom: 30px; }
    .footer-brand { font-size: 1.05rem; font-weight: 800; color: white; display: flex; align-items: center; gap: 10px; }
    .footer-description { max-width: 480px; color: #adc8ba; font-size: .88rem; margin: 10px 0 0; line-height: 1.6; }
    .footer-links { display: flex; gap: 20px; flex-wrap: wrap; font-size: .88rem; font-weight: 600; }
    .footer-links a { color: #d8e8df; transition: color .2s; }
    .footer-links a:hover { color: var(--gold-light); }
    .copyright { border-top: 1px solid rgba(255,255,255,.12); padding-top: 20px; color: #9fbdad; font-size: .8rem; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

    /* ==========================================================================
       8. RESPONSIVE BREAKPOINTS
       ========================================================================== */
    @media (max-width: 992px) {
      .gallery-grid { grid-template-columns: repeat(2, 1fr); }
      .lightbox-content { grid-template-columns: 1fr; max-height: 85vh; overflow-y: auto; }
      .lightbox-image-wrap { max-height: 350px; }
      .lightbox-close { background: white; box-shadow: 0 4px 10px rgba(0,0,0,.2); }
    }

    @media (max-width: 768px) {
      .nav-links { gap: 14px; }
      .nav-links a:not(.btn) { display: none; }
      .topbar-inner { justify-content: center; text-align: center; }
      .page-banner { padding: 42px 0 54px; }
      .filter-bar { width: 100%; overflow-x: auto; justify-content: flex-start; padding: 8px 10px; border-radius: 16px; }
      .filter-btn { white-space: nowrap; padding: 7px 14px; font-size: .82rem; }
    }

    @media (max-width: 600px) {
      .container { width: min(100% - 32px, 1120px); }
      .gallery-grid { grid-template-columns: 1fr; }
      .footer-main { flex-direction: column; }
      .copyright { flex-direction: column; gap: 8px; text-align: center; }
      .banner-actions { flex-direction: column; width: 100%; max-width: 300px; }
      .banner-actions .btn { width: 100%; }
    }
  </style>
</head>
