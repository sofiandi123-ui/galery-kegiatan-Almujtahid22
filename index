      {
        img: "Screenshot 2026-11-04 18.39.32.png-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=1200&q=80",
        tag: "Sosial & Ziswaf",
        title: "Penyaluran Santunan Yatim & Dhuafa",
        date: "25 Januari 2026",
        desc: "Penyerahan paket sembako dan beasiswa pendidikan hasil pengelolaan zakat, infak, dan sedekah dari keluarga besar SMAN 22 Bandung kepada warga sekitar."
      },
      {
        img: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=1200&q=80",
        tag: "Ekstrakurikuler",
        title: "Latihan Seni Hadroh & Seni Islam Rohis",
        date: "18 Januari 2026",
        desc: "Latihan terpadu tim kesenian Islami Rohis SMAN 22 Bandung untuk persiapan pengisian acara syiar dan perlombaan antarsekolah di Kota Bandung."
      },
      {
        img: "https://images.unsplash.com/photo-1519817650390-64a93db51149?auto=format&fit=crop&w=1200&q=80",
        tag: "Sosial & Ziswaf",
        title: "Bakti Bersih Masjid & Lingkungan Sekolah",
        date: "10 Januari 2026",
        desc: "Aksi pembersihan karpet, area wudhu, dan penataan perpustakaan Masjid Al Mujtahid secara gotong royong oleh pengurus DKM dan siswa pengurus kelas."
      },
      {
        img: "https://images.unsplash.com/photo-1609599006353-e629aa5cfb71?auto=format&fit=crop&w=1200&q=80",
        tag: "Kajian & Mentoring",
        title: "Program Tahsin & Hifdzil Qur'an",
        date: "02 Januari 2026",
        desc: "Bimbingan kelancaran membaca Al-Qur'an sesuai tajwid serta penyetoran hafalan juz 30 rutin sebelum jam pelajaran sekolah dimulai."
      }
    ];

    let currentLightboxIndex = 0;

    // Filter Kategori
    const filterBtns = document.querySelectorAll('.filter-btn');
    const galleryCards = document.querySelectorAll('.gallery-card');
    const noResults = document.getElementById('noResults');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle Active Button
        filterBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        const filterValue = btn.getAttribute('data-filter');
        let visibleCount = 0;

        galleryCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filterValue === 'all' || category === filterValue) {
            card.classList.remove('hide');
            visibleCount++;
          } else {
            card.classList.add('hide');
          }
        });

        // Show/hide empty state
        if (visibleCount === 0) {
          noResults.style.display = 'block';
        } else {
          noResults.style.display = 'none';
        }
      });
    });

    // Modal Lightbox Functions
    const modal = document.getElementById('lightboxModal');
    const modalImg = document.getElementById('modalImg');
    const modalTag = document.getElementById('modalTag');
    const modalTitle = document.getElementById('modalTitle');
    const modalDate = document.getElementById('modalDate');
    const modalDesc = document.getElementById('modalDesc');

    function openLightbox(index) {
      currentLightboxIndex = index;
      updateLightboxContent();
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }

    function updateLightboxContent() {
      const data = galleryData[currentLightboxIndex];
      modalImg.src = data.img;
      modalTag.textContent = data.tag;
      modalTitle.textContent = data.title;
      modalDate.querySelector('span').textContent = data.date;
      modalDesc.textContent = data.desc;
    }

    function prevLightbox() {
      currentLightboxIndex = (currentLightboxIndex - 1 + galleryData.length) % galleryData.length;
      updateLightboxContent();
    }

    function nextLightbox() {
      currentLightboxIndex = (currentLightboxIndex + 1) % galleryData.length;
      updateLightboxContent();
    }

    // Close on overlay click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeLightbox();
      }
    });

    // Keyboard navigation (Esc, Left, Right)
    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') prevLightbox();
      if (e.key === 'ArrowRight') nextLightbox();
    });
  </script>
